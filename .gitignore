# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb 

# Data files (large CSV and binary files)
data/raw/
data/raw/*.csv
data/raw/*.txt
data/raw/*.pcap
data/processed/
data/processed/*.npy
data/processed/*.pkl
*.h5
*.hdf5
*.csv
*.pcap

# Model files (can be large)
models/*.pkl
models/*.h5
models/*.pb
models/*.pt
models/*.pth

# Logs
logs/*.log
*.log

# OS
.DS_Store
Thumbs.db

# Distribution / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Environment variables / secrets / credentials
# (this project stores no secrets; these patterns are preventative)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.crt
credentials.json
secrets.json
*_secret*
.netrc

# Temporary files
*.tmp
*.temp
temp/
tmp/
data/processed/

# Phase 2: fitted preprocessing artefacts (regenerate: python scripts/prepare_nsl_kdd.py)
artifacts/
*.joblib
*.pt
*.keras
# ...but keep the committed result/evidence files under results/
!results/**/dataset_stats.md
!results/**/dataset_stats.json
!results/**/metrics.csv
!results/**/metrics.json
!results/**/model_comparison.md
# Phase 4 cross-dataset generalisation evidence
!results/**/generalization.md
!results/**/common_schema.md
# Phase 7 replay / simulation detection: committed sample + measured results
!data/replay_samples/
!data/replay_samples/*.csv
!results/replay/
!results/replay/*.json
